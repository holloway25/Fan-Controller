# Reference nginx site for the fan controller.
# Copy to /etc/nginx/sites-available/, replace example.com, symlink into
# sites-enabled, then:
#
#     sudo nginx -t && sudo systemctl reload nginx
#
# Flask must be bound to 127.0.0.1 (it is by default).

# Here rather than in nginx.conf. Debian and Ubuntu include
# sites-enabled from the http context, so the top of this file IS http
# context and the zone loads with the site - which means the file works
# as copied. It would not load inside a server block below.
#
# The rate limit further down references it by name. If the zone is
# missing nginx refuses to start rather than skipping the limit quietly,
# so a mistake here is loud.
limit_req_zone $binary_remote_addr zone=client_errors:1m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    # The literal name, not $host. $host comes from the request, so a
    # forged Host header would be handed straight back as a redirect
    # target. Replace it along with server_name above.
    return 301 https://example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # /api/history carries the 24h trace and is well over 100KB
    # uncompressed. nginx does not gzip JSON by default: gzip_types
    # defaults to text/html only.
    gzip on;
    gzip_types application/json;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;

    # The browser error reporter. It stays open even once a UI password
    # is set - a page that cannot load its own script cannot authenticate
    # to say so - and every accepted request writes the journal. The
    # application already caps bodies at 8KB and repeats the same message
    # to the activity log at most once a minute, but neither limits the
    # journal, so the rate limit is here. Requires the limit_req_zone at
    # the top of this file to be present in nginx.conf.
    location = /api/clienterror {
        limit_req zone=client_errors burst=5 nodelay;

        proxy_pass http://127.0.0.1:8096;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }

    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Overwrite rather than append. ProxyFix trusts a hop count, not a
        # peer, so the header must be one nginx alone controls.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 60s;
    }
}
